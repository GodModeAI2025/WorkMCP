# Kopieren nach .env und anpassen (die Datei .env wird nicht eingecheckt)
ARCHIVY_ADMIN_USER=admin
ARCHIVY_ADMIN_PASSWORD=bitte-aendern-mindestens-8-zeichen

# Ports auf dem Host (nur 127.0.0.1)
ARCHIVY_PORT=5000
WORKMCP_PORT=8000

# Erlaubte Host-Header für WorkMCP (Schutz gegen DNS-Rebinding), kommagetrennt; localhost ist immer erlaubt.
# Beim Zugriff über einen Reverse Proxy dessen Hostnamen ergänzen, z. B. localhost:*,mcp.firma.de
WORKMCP_ALLOWED_HOSTS=localhost:*

# Optional: kostenloser Adzuna-Developer-Key für adzuna_salary
WORKMCP_ADZUNA_APP_ID=
WORKMCP_ADZUNA_APP_KEY=

# Optional: Basis-Images, z. B. bei Docker-Hub-Rate-Limits einen Spiegel nutzen
# ARCHIVY_PYTHON_IMAGE=mirror.gcr.io/library/python:3.11-slim
# WORKMCP_PYTHON_IMAGE=mirror.gcr.io/library/python:3.13-slim
